# This app is a standalone frontend that joins the existing warehouse-tracker
# (gearroom) Supabase stack over Docker's network — it does not run its own
# Postgres/Auth/Kong. See docker-compose.yml. For the stack's own secrets
# (JWT_SECRET, POSTGRES_PASSWORD, etc.), see warehouse-tracker's .env.example.

# Public URL of the gearroom Supabase stack, reachable from the browser
# (e.g. the server's Tailscale URL). Baked into the client bundle at build
# time — see the Dockerfile comment on NEXT_PUBLIC_* build args.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# gearroom's ANON_KEY (from warehouse-tracker's .env after running
# utils/generate-keys.sh). Same value for NEXT_PUBLIC_SUPABASE_ANON_KEY and
# ANON_KEY below — the former is baked into the client bundle at build time,
# the latter is read live at runtime by server-side code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANON_KEY=

# gearroom's SERVICE_ROLE_KEY — server-only, bypasses Row Level Security.
SERVICE_ROLE_KEY=

# Used by lib/image-search.ts / lib/vision.ts.
GEMINI_API_KEY=
EXA_API_KEY=
